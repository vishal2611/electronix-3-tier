pipeline{
    agent { label 'electronix'}

    environment {
        ECR_REPO='508375325844.dkr.ecr.us-east-1.amazonaws.com/electronix-ecr'
        AWS_REGION = "us-east-1"
    }

    stages{
        stage("Test ECR Login"){
            steps {
                sh ''' 
                aws ecr get-login-password --region ${AWS_REGION} | docker login --username  AWS --password-stdin ${ECR_RPO}
                '''
            }
        }
    }
    post {
        success{
            echo "ECR Login Success ✅"
        }
        failure {
            echo "ECR Login Failed ❌"
        }
    }
}